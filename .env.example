# Svasthi environment template — copy to .env.local and fill in.
# NEVER commit .env.local or any real key.

# ---- Supabase (publishable values — these ARE safe for the browser) ----
# Project URL and anon key from Supabase Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Gemini (server-side only) ----
# Keep this server-side. Never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Verify the deployed model with /api/health.
GEMINI_MODEL=gemini-2.5-flash
# true guarantees deterministic local insight/chat fallbacks for a live demo.
DEMO_MODE=true

# ---- Optional ----
# URL of a separately deployed frontend, for browser API access (CORS).
# FRONTEND_ORIGIN=https://your-frontend.example
